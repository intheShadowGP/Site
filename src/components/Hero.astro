---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).hero;
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow rise"><span class="seal"></span>{d.eyebrow}</p>
      <h1 class="hero__title rise" id="hero-title">
        <span class="hero__title-gp">GP</span>
        <span class="hero__subtitle">{d.subtitle}</span>
      </h1>
      <p class="hero__text rise">{d.text}</p>
      <div class="hero__actions rise">
        <a class="btn btn--primary" href="#about">
          {d.ctaProfile}<span class="btn__arrow" aria-hidden="true"></span>
        </a>
        <a class="btn" href="#projects">
          {d.ctaProjects}<span class="btn__arrow" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__plate">
        <span class="hero__corner hero__corner--tl" aria-hidden="true"></span>
        <span class="hero__corner hero__corner--tr" aria-hidden="true"></span>
        <span class="hero__corner hero__corner--bl" aria-hidden="true"></span>
        <span class="hero__corner hero__corner--br" aria-hidden="true"></span>
        <span class="hero__tag hero__tag--top" aria-hidden="true">GP / 01</span>
        <span class="hero__tag hero__tag--side" aria-hidden="true">SYS · NET · SEC</span>
        <Logo id="logo-hero" class="hero__logo" label="GP" />
      </div>
      <figcaption class="hero__caption">{d.figure}</figcaption>
    </figure>
  </div>

  <div class="container">
    <dl class="hero__facts">
      {
        d.facts.map((fact, i) => (
          <div class="hero__fact reveal" data-delay={String(i + 1)}>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vh, 5rem));
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* Architectural grid + a single, very low red light. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 46% at 72% 44%, rgb(142 21 27 / 0.16), transparent 70%),
      radial-gradient(30% 30% at 72% 44%, rgb(197 164 90 / 0.05), transparent 70%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / calc(100% / 6) 100%;
    mask-image: radial-gradient(85% 80% at 60% 45%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(85% 80% at 60% 45%, #000 30%, transparent 85%);
    opacity: 0.55;
  }

  /* Above the fold: visible from the first paint (no opacity fade that
     would delay the largest contentful paint), only a short rise. */
  .rise {
    animation: rise 900ms var(--ease-out) both;
  }
  .hero__title.rise {
    animation-delay: 60ms;
  }
  .hero__text.rise {
    animation-delay: 120ms;
  }
  .hero__actions.rise {
    animation-delay: 180ms;
  }
  @keyframes rise {
    from {
      transform: translateY(14px);
    }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__title {
    margin-top: clamp(1.5rem, 3vh, 2.25rem);
    display: grid;
    gap: 1.1rem;
  }
  .hero__title-gp {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(5.5rem, 3rem + 11vw, 11.5rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
    background: var(--metal-silver);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.04em;
  }
  .hero__subtitle {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero__subtitle::before {
    content: '';
    width: 2.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--red), var(--gold));
  }

  .hero__text {
    margin-top: clamp(1.75rem, 3.5vh, 2.5rem);
    max-width: 36rem;
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .hero__actions {
    margin-top: clamp(2rem, 4.5vh, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* ---------- Figure ---------- */
  .hero__figure {
    justify-self: end;
    width: min(100%, 30rem);
  }
  .hero__plate {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.035), transparent 62%),
      linear-gradient(160deg, var(--black-2), var(--black) 70%);
    box-shadow: var(--shadow-deep);
    overflow: hidden;
  }
  /* crosshair */
  .hero__plate::before {
    content: '';
    position: absolute;
    inset: 9%;
    background:
      linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--line), var(--line)) 0 50% / 100% 1px no-repeat;
    opacity: 0.55;
  }
  /* one slow metallic reflection crossing the plate */
  .hero__plate::after {
    content: '';
    position: absolute;
    inset: -40%;
    background: linear-gradient(115deg, transparent 42%, rgb(226 201 140 / 0.09) 49%, rgb(255 255 255 / 0.05) 50%, transparent 57%);
    transform: translateX(-60%);
    animation: sheen 3.2s var(--ease) 1.4s 1 both;
    pointer-events: none;
  }
  @keyframes sheen {
    to {
      transform: translateX(60%);
    }
  }

  .hero__plate :global(.hero__logo) {
    position: relative;
    width: 68%;
    height: auto;
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.8));
  }
  .hero__plate :global(.gp-logo__g),
  .hero__plate :global(.gp-logo__p) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.8s var(--ease-out) 0.25s forwards;
  }
  .hero__plate :global(.gp-logo__p) {
    animation-delay: 0.6s;
  }
  .hero__plate :global(.gp-logo__frame) {
    opacity: 0;
    animation: fade 1.4s var(--ease) 0.9s forwards;
  }
  .hero__plate :global(.gp-logo__seal) {
    opacity: 0;
    transform-origin: 99.5px 99.5px;
    animation: stamp 0.6s var(--ease-out) 1.9s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 0.75;
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(1.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--gold);
    border-style: solid;
    border-width: 0;
    opacity: 0.8;
  }
  .hero__corner--tl {
    top: 10px;
    left: 10px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .hero__corner--tr {
    top: 10px;
    right: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .hero__corner--bl {
    bottom: 10px;
    left: 10px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .hero__corner--br {
    bottom: 10px;
    right: 10px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .hero__tag {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-wide);
    color: var(--text-faint);
  }
  .hero__tag--top {
    top: 1.4rem;
    left: 2.2rem;
  }
  .hero__tag--side {
    right: 1.15rem;
    bottom: 2.2rem;
    writing-mode: vertical-rl;
  }
  .hero__caption {
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-mid);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ---------- Facts ---------- */
  .hero__facts {
    margin-top: clamp(3.5rem, 8vh, 6rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .hero__fact {
    padding: 1.4rem 1.5rem 0 0;
  }
  .hero__fact + .hero__fact {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .hero__fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero__fact dd {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (max-width: 959px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figure {
      justify-self: start;
      width: min(100%, 22rem);
      order: -1;
    }
  }
  @media (max-width: 639px) {
    .hero__figure {
      width: min(52%, 12.5rem);
    }
    .hero__tag {
      display: none;
    }
    .hero__facts {
      grid-template-columns: 1fr;
    }
    .hero__fact,
    .hero__fact + .hero__fact {
      padding: 1rem 0;
      border-left: 0;
    }
    .hero__fact + .hero__fact {
      border-top: 1px solid var(--line);
    }
    .hero__actions .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
