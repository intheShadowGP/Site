---
import SectionHeader from './SectionHeader.astro';
import { pick, t, type Lang } from '../i18n';
import { certifications, education, educationStatus } from '../data/education';
import { SITE } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).education;
---

<section id="education" class="section education" aria-labelledby="education-title">
  <div class="container">
    <SectionHeader id="education" index="04" label={d.label} title={d.title} intro={d.intro} />

    <div class="degrees">
      {
        education.map((entry, i) => {
          const status = educationStatus(entry, SITE.buildDate);
          return (
            <article class="degree reveal" data-delay={String(i)} data-status={status}>
              <header class="degree__head">
                <span class="degree__level">{pick(entry.level, lang)}</span>
                <span class="status" data-status={status}>
                  {d.status[status]}
                </span>
              </header>
              <h3 class="degree__title">{pick(entry.title, lang)}</h3>
              <p class="degree__timing">{pick(entry.timing(status), lang)}</p>

              {entry.topics.length > 0 && (
                <div class="degree__topics">
                  <h4 class="degree__topics-title">{d.topicsTitle}</h4>
                  <ul class="topics">
                    {entry.topics.map((topic) => (
                      <li>{pick(topic, lang)}</li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <div class="certs reveal">
      <h3 class="certs__title">{d.certTitle}</h3>
      {
        certifications.length === 0 ? (
          <p class="certs__none">{d.certNone}</p>
        ) : (
          <ul class="certs__list">
            {certifications.map((cert) => (
              <li>
                <span>{cert.name}</span>
                <span class="status" data-status={cert.status === 'obtained' ? 'completed' : 'inProgress'}>
                  {d.certStatus[cert.status]}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .degrees {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }
  .degree {
    position: relative;
    padding: 2rem clamp(1.25rem, 2.5vw, 2.5rem) 2.25rem;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--black-2), var(--black) 80%);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .degree::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 1px;
    background: var(--edge-gold);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .degree:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-deep);
  }
  .degree:hover::before {
    opacity: 1;
  }
  .degree__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .degree__level {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--gold);
  }
  .degree__title {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.15rem);
    line-height: 1.15;
    color: var(--ivory);
  }
  .degree__timing {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .degree__topics {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .degree__topics-title {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .topics {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topics li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    font-size: 0.78rem;
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .topics li:hover {
    border-color: var(--line-gold);
    color: var(--ivory);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .status::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--silver);
  }
  .status[data-status='completed'] {
    border-color: var(--line-gold);
    color: var(--gold-light);
  }
  .status[data-status='completed']::before {
    background: var(--gold);
  }
  .status[data-status='inProgress']::before {
    background: var(--red);
    box-shadow: 0 0 8px rgb(198 40 50 / 0.6);
  }

  .certs {
    margin-top: var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1rem var(--gutter);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .certs__title {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--gold);
  }
  .certs__none {
    max-width: 44rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .certs__list li {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 959px) {
    .degrees {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
