---
interface Props {
  index: string;
  label: string;
  title: string;
  intro?: string;
  id: string;
}
const { index, label, title, intro, id } = Astro.props;
---

<header class="section-head">
  <div class="section-head__rail reveal" aria-hidden="true">
    <span class="seal"></span>
    <span class="section-head__index">{index}</span>
    <span class="section-head__label">{label}</span>
  </div>
  <div class="section-head__main">
    <h2 class="section-head__title reveal" id={`${id}-title`}>{title}</h2>
    {intro && <p class="section-head__intro reveal" data-delay="1">{intro}</p>}
  </div>
</header>

<style>
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 2rem var(--gutter);
    padding-top: 1.75rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-top: 1px solid var(--line);
    position: relative;
  }
  .section-head::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(4rem, 12vw, 9rem);
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
  }
  .section-head__rail {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    align-self: start;
    padding-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
  }
  .section-head__index {
    color: var(--gold);
  }
  .section-head__label {
    color: var(--text-faint);
  }
  .section-head__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-h2);
    letter-spacing: -0.01em;
    line-height: 1.02;
    color: var(--ivory);
  }
  .section-head__intro {
    margin-top: 1.5rem;
    max-width: 44rem;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  @media (max-width: 767px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
