---
import SectionHeader from './SectionHeader.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).about;
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader id="about" index="01" label={d.label} title={d.title} />

    <div class="about__grid">
      <aside class="sheet reveal" aria-labelledby="about-sheet-title">
        <h3 class="sheet__title" id="about-sheet-title">{d.sheetTitle}</h3>
        <dl class="sheet__list">
          {
            d.sheet.map((row) => (
              <div class="sheet__row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>

      <div class="about__body">
        {
          d.paragraphs.map((p, i) => (
            <p class:list={['about__p reveal', { 'about__p--lead': i === 0 }]} data-delay={String(i)}>
              {p}
            </p>
          ))
        }
      </div>
    </div>

    <h3 class="visually-hidden">{d.axesTitle}</h3>
    <ol class="axes">
      {
        d.axes.map((axis, i) => (
          <li class="axis reveal" data-delay={String(i)}>
            <span class="axis__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="axis__rule" aria-hidden="true" />
            <h4 class="axis__title">{axis.title}</h4>
            <p class="axis__text">{axis.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 3rem var(--gutter);
  }

  .sheet {
    align-self: start;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--black-2), var(--black));
    padding: 1.4rem 1.4rem 0.6rem;
    position: relative;
  }
  .sheet::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 1px;
    background: var(--edge-gold);
    opacity: 0.6;
  }
  .sheet__title {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--gold);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .sheet__row {
    padding: 0.85rem 0;
  }
  .sheet__row + .sheet__row {
    border-top: 1px dashed var(--line);
  }
  .sheet__row dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .sheet__row dd {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    color: var(--ivory);
  }

  .about__body {
    max-width: 50rem;
    display: grid;
    gap: 1.5rem;
  }
  .about__p {
    color: var(--text-muted);
  }
  .about__p--lead {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.35rem);
    line-height: 1.3;
    color: var(--ivory);
    margin-bottom: 0.75rem;
  }

  .axes {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .axis {
    position: relative;
    padding: 2.25rem clamp(1.25rem, 2.5vw, 2.5rem) 2.5rem;
    transition: background-color var(--dur) var(--ease);
  }
  .axis + .axis {
    border-left: 1px solid var(--line);
  }
  .axis:first-child {
    padding-left: 0;
  }
  .axis__index {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    color: var(--gold);
  }
  .axis__rule {
    display: block;
    margin: 1.4rem 0 1.6rem;
    width: 2rem;
    height: 1px;
    background: var(--red);
    transition: width var(--dur-slow) var(--ease-out);
  }
  .axis:hover .axis__rule {
    width: 5rem;
  }
  .axis__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h3);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ivory);
  }
  .axis__text {
    margin-top: 0.85rem;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 22rem;
  }

  @media (max-width: 959px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .sheet {
      order: 2;
    }
    .axes {
      grid-template-columns: 1fr;
    }
    .axis,
    .axis:first-child {
      padding: 1.75rem 0;
    }
    .axis + .axis {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
