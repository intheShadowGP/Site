---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { LANG_META, LANGS, homePath, t } from '../i18n';
import { withBase } from '../config/paths';

const en = t('en');
const fr = t('fr');
---

<BaseLayout
  lang="mul"
  title={en.meta.title}
  description={en.meta.description}
  path={withBase('/')}
  alternates={Object.fromEntries(LANGS.map((l) => [l, homePath(l)]))}
  gate
  bodyClass="gate-body"
>
  <!-- Screen 1 — loading. Visual only; progress mirrors real loading stages. -->
  <div class="loader" data-loader aria-hidden="true">
    <div class="loader__inner">
      <Logo id="logo-loader" class="loader__logo" />
      <div class="loader__line"><span class="loader__progress" data-progress></span></div>
      <p class="loader__text">
        <span>Initializing interface</span>
        <span class="loader__percent" data-percent>000</span>
      </p>
      <p class="loader__sub" lang="fr">Initialisation de l'interface</p>
    </div>
  </div>

  <!-- Screen 2 — language selection. Plain links: works without JS or storage. -->
  <main class="gate" id="main">
    <div class="gate__frame" aria-hidden="true"></div>
    <div class="gate__inner">
      <Logo id="logo-gate" class="gate__logo" />
      <h1 class="gate__title">
        <span>Welcome to GP</span>
        <span class="gate__title-fr" lang="fr">Bienvenue</span>
      </h1>
      <p class="gate__subtitle" id="gate-prompt">
        <span>Select your language</span>
        <span class="gate__sep" aria-hidden="true">·</span>
        <span lang="fr">Choisissez votre langue</span>
      </p>

      <ul class="gate__options" aria-labelledby="gate-prompt">
        {
          LANGS.map((l) => (
            <li>
              <a class="option" href={homePath(l)} hreflang={l} lang={l} data-choose={l}>
                <span class="option__code">{LANG_META[l].code}</span>
                <span class="option__rule" aria-hidden="true" />
                <span class="option__label">{LANG_META[l].label}</span>
                <span class="option__arrow" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="gate__error" role="alert" data-gate-error hidden>
        <span lang="en">{en.errors.storage}</span>
        <span lang="fr">{fr.errors.storage}</span>
      </p>

      <p class="gate__note">
        <span>{en.contact.privacy.slice(0, 3).join(' · ')}</span>
      </p>
    </div>
  </main>

  <div class="curtain" aria-hidden="true"></div>
</BaseLayout>

<style>
  :global(html.is-redirecting) .gate,
  :global(html.is-redirecting) .loader {
    visibility: hidden;
  }

  /* ---------- Loader ---------- */
  .loader {
    display: none;
  }
  :global(html.js) .loader {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    background: var(--black);
    transition:
      opacity 700ms var(--ease),
      visibility 0s linear 700ms;
    /* failsafe: never trap the visitor behind the loader */
    animation: loader-failsafe 0.6s var(--ease) 6s forwards;
  }
  :global(html.js) .loader.is-done {
    opacity: 0;
    visibility: hidden;
    animation: none;
  }
  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  .loader__inner {
    width: min(18rem, 70vw);
    display: grid;
    justify-items: center;
  }
  .loader :global(.loader__logo) {
    width: 6.5rem;
    height: 6.5rem;
  }
  .loader :global(.gp-logo__g),
  .loader :global(.gp-logo__p),
  .loader :global(.gp-logo__frame path:first-child) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1s var(--ease-out) forwards;
  }
  .loader :global(.gp-logo__p) {
    animation-delay: 0.25s;
  }
  .loader :global(.gp-logo__frame path:first-child) {
    animation-duration: 1.3s;
  }
  .loader :global(.gp-logo__frame path:last-child),
  .loader :global(.gp-logo__seal) {
    opacity: 0;
    animation: appear 0.5s var(--ease) 0.9s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  .loader__line {
    position: relative;
    margin-top: 2.25rem;
    width: 100%;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .loader__progress {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--red-deep), var(--red) 40%, var(--gold) 80%, var(--gold-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 450ms var(--ease-out);
  }
  /* the scale value is driven by a class per real loading stage */
  .loader__progress[data-stage='1'] {
    transform: scaleX(0.34);
  }
  .loader__progress[data-stage='2'] {
    transform: scaleX(0.68);
  }
  .loader__progress[data-stage='3'] {
    transform: scaleX(1);
  }
  .loader__text {
    margin-top: 1.1rem;
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .loader__percent {
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .loader__sub {
    margin-top: 0.4rem;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-mid);
    color: var(--text-faint);
  }

  /* ---------- Gate ---------- */
  :global(.gate-body) {
    overflow: hidden auto;
  }
  .gate {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 3rem var(--gutter);
    background:
      radial-gradient(45% 40% at 50% 38%, rgb(142 21 27 / 0.16), transparent 70%),
      radial-gradient(70% 60% at 50% 100%, rgb(197 164 90 / 0.05), transparent 70%),
      var(--black);
    isolation: isolate;
  }
  .gate__frame {
    position: absolute;
    inset: clamp(0.75rem, 2.5vw, 2rem);
    border: 1px solid var(--line);
    z-index: -1;
    pointer-events: none;
  }
  .gate__frame::before,
  .gate__frame::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    height: clamp(2rem, 8vh, 5rem);
    background: linear-gradient(var(--gold), transparent);
  }
  .gate__frame::before {
    top: -1px;
  }
  .gate__frame::after {
    bottom: -1px;
    transform: rotate(180deg);
  }

  .gate__inner {
    width: min(100%, 34rem);
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .gate :global(.gate__logo) {
    width: clamp(4.5rem, 12vw, 6rem);
    height: auto;
  }
  .gate__title {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.75rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--metal-silver);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .gate__title-fr {
    font-style: italic;
    font-size: 0.42em;
    text-transform: none;
    letter-spacing: 0.04em;
    background: var(--metal-gold);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .gate__subtitle {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .gate__sep {
    color: var(--red);
  }

  .gate__options {
    margin-top: 2.5rem;
    width: 100%;
    display: grid;
    gap: 0.85rem;
  }
  .option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-height: 4.25rem;
    padding: 0 1.5rem;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent);
    text-align: left;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .option::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(142 21 27 / 0.32), rgb(198 40 50 / 0.08) 60%, transparent);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .option::after {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 1px;
    background: var(--edge-gold);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .option:hover,
  .option:focus-visible {
    border-color: var(--gold);
    box-shadow: 0 18px 50px -24px rgb(198 40 50 / 0.6);
  }
  .option:hover::before,
  .option:focus-visible::before,
  .option:hover::after,
  .option:focus-visible::after {
    opacity: 1;
  }
  .option:active {
    transform: scale(0.995);
  }
  .option__code {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: var(--track-mid);
    color: var(--gold);
  }
  .option__rule {
    width: 1.5rem;
    height: 1px;
    background: var(--line-strong);
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .option:hover .option__rule,
  .option:focus-visible .option__rule {
    width: 2.5rem;
    background: var(--gold);
  }
  .option__label {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ivory);
  }
  .option__arrow {
    margin-left: auto;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--text-faint);
    border-right: 1px solid var(--text-faint);
    transform: rotate(45deg);
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .option:hover .option__arrow,
  .option:focus-visible .option__arrow {
    border-color: var(--gold-light);
    transform: translateX(4px) rotate(45deg);
  }
  .option[aria-busy='true'] {
    border-color: var(--gold);
  }

  .gate__error {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgb(198 40 50 / 0.6);
    font-size: var(--fs-small);
    color: var(--ivory);
  }
  .gate__error[hidden] {
    display: none;
  }
  .gate__note {
    margin-top: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* gate content rises in once the loader is gone */
  :global(html.js) .gate__inner > * {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 800ms var(--ease-out),
      transform 800ms var(--ease-out);
    animation: reveal-failsafe 0s linear 6.6s forwards;
  }
  :global(html.js.is-ready) .gate__inner > * {
    opacity: 1;
    transform: none;
    animation: none;
  }
  :global(html.js.is-ready) .gate__inner > :nth-child(2) {
    transition-delay: 80ms;
  }
  :global(html.js.is-ready) .gate__inner > :nth-child(3) {
    transition-delay: 160ms;
  }
  :global(html.js.is-ready) .gate__inner > :nth-child(n + 4) {
    transition-delay: 240ms;
  }
  :global(html.js) .gate__inner > .gate__error[hidden] {
    display: none;
  }

  /* ---------- Exit transition ---------- */
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    background: var(--black);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 620ms cubic-bezier(0.7, 0, 0.2, 1);
  }
  .curtain::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--red) 25%, var(--gold) 50%, var(--red) 75%, transparent);
  }
  :global(html.is-leaving) .curtain {
    transform: scaleY(1);
  }
</style>

<script>
  import '../scripts/gate';
</script>
