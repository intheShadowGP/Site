---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { homePath } from '../i18n';
import { withBase } from '../config/paths';
---

<BaseLayout
  lang="mul"
  title="404 — GP"
  description="Page introuvable · Page not found"
  path={withBase('/404/')}
  noindex
>
  <main class="nf" id="main">
    <Logo id="logo-404" class="nf__logo" />
    <p class="nf__code">Error 404</p>
    <h1 class="nf__title">
      <span lang="fr">Page introuvable</span>
      <span lang="en">Page not found</span>
    </h1>
    <p class="nf__text">
      <span lang="fr">La ressource demandée n'existe pas ou a été déplacée.</span>
      <span lang="en">The requested resource does not exist or has moved.</span>
    </p>
    <ul class="nf__links">
      <li><a class="btn" href={homePath('fr')} hreflang="fr" lang="fr">Retour à l'accueil<span class="btn__arrow" aria-hidden="true"></span></a></li>
      <li><a class="btn" href={homePath('en')} hreflang="en" lang="en">Back to home<span class="btn__arrow" aria-hidden="true"></span></a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0;
    padding: 3rem var(--gutter);
    text-align: center;
    background: radial-gradient(45% 40% at 50% 40%, rgb(142 21 27 / 0.14), transparent 70%), var(--black);
  }
  .nf :global(.nf__logo) {
    width: 4.5rem;
    height: 4.5rem;
  }
  .nf__code {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--gold);
  }
  .nf__title {
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
    color: var(--ivory);
  }
  .nf__title [lang='en'] {
    font-style: italic;
    font-size: 0.55em;
    color: var(--gold);
  }
  .nf__text {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.25rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .nf__links {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
